-            calc_tv(pcm, taps, 1, pcm.ram2[30][0], &pcm.ram2[30][9], active, &u);
+            calc_tv<1>(pcm, taps, pcm.ram2[30][0], &pcm.ram2[30][9], active, &u);
         }
 
         {
@@ -1417,9 +1423,9 @@
             int volmul1 = 0;
             int volmul2 = 0;
 
