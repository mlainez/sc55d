+// `type` and the tap selector are a pure function of the 8-bit `speed` field
+// and of pcm.nfs, which only ever clears bit 3.  256 bytes, built at compile
+// time from the same expressions it replaces.
+struct calc_tv_type_lut_t
+{
+    uint8_t v[256];
+    constexpr calc_tv_type_lut_t() : v()
+    {
+        for (int speed = 0; speed < 256; speed++)
+        {
+            const bool w1 = (speed & 0xf0) == 0;
+            const bool w2 = w1 || (speed & 0x10) != 0;
+            const bool w3 = ((speed & 0x80) == 0
+                             || ((speed & 0x40) == 0 && (!w2 || (speed & 0x20) == 0)));
+            int type = (int)w2 | ((int)w3 << 3);
+            if (speed & 0x20)
+                type |= 2;
+            if ((speed & 0x80) == 0 || (speed & 0x40) == 0)
+                type |= 4;
+            const int sel = (type & 4) ? 4 : (type & 3);
+            v[speed] = (uint8_t)(type | (sel << 4));
+        }
+    }
+};
+static constexpr calc_tv_type_lut_t calc_tv_type_lut{};
+
+// Per-tick invariants of calc_tv().
+//
+// calc_tv() is called 97 times per PCM tick (3 per voice slot, plus one for the
+// pseudo-slot 31 chorus/reverb envelope).  Two of the things it computes do not
+// depend on the slot at all:
+//
+//   * `addlow`, a four-bit reversal of four bits tapped out of pcm.tv_counter,
+//   * the counter half of the `write` enable,
+//
+// and both depend on `type` only through a five-way selector: `type & 4` picks
+// one tap set, otherwise `type & 3` picks one of four more.  pcm.tv_counter is
+// updated exactly once per tick, so all five (addlow, write) pairs can be
+// computed once a tick and indexed instead of recomputed 97 times.
+struct tv_taps
+{
+    uint8_t addlow[5];
+    uint8_t write[5];
+};
+
+inline void tv_taps_compute(tv_taps& t, uint32_t c)
+{
+    // bit-reversed four-bit taps; the shifts below mirror the original
+    // `if (counter & bit) addlow |= n;` ladders exactly.
+    t.addlow[0] = (uint8_t)(((c >> 5) & 1) | (((c >> 4) & 1) << 1) | (((c >> 3) & 1) << 2) | (((c >> 2) & 1) << 3));
+    t.addlow[1] = (uint8_t)(((c >> 7) & 1) | (((c >> 6) & 1) << 1) | (((c >> 5) & 1) << 2) | (((c >> 4) & 1) << 3));
+    t.addlow[2] = (uint8_t)(((c >> 9) & 1) | (((c >> 8) & 1) << 1) | (((c >> 7) & 1) << 2) | (((c >> 6) & 1) << 3));
+    t.addlow[3] = (uint8_t)(((c >> 11) & 1) | (((c >> 10) & 1) << 1) | (((c >> 9) & 1) << 2) | (((c >> 8) & 1) << 3));
+    t.addlow[4] = (uint8_t)(((c >> 3) & 1) | (((c >> 2) & 1) << 1) | (((c >> 1) & 1) << 2) | (((c >> 0) & 1) << 3));
+    t.write[0]  = (uint8_t)((c & 3) == 0);
+    t.write[1]  = (uint8_t)((c & 15) == 0);
+    t.write[2]  = (uint8_t)((c & 63) == 0);
+    t.write[3]  = (uint8_t)((c & 127) == 0);
+    t.write[4]  = 1;
+}
