+    uint8_t ff_sig[7 + 128]{};      // regs + zero-page RAM at the last head visit
+    uint16_t ff_head = 0;           // candidate loop head (target of a backward jump)
+    uint8_t ff_state = 0;           // 0 seeking, 1 recording, 2 stationary
+    uint8_t ff_len = 0;             // instructions per pass
+    uint8_t ff_pos = 0;             // index within the pass of the next instruction
+    uint8_t ff_impure = 0;          // set by SM_Read/SM_Write on any non-zero-page access
+    uint8_t ff_ahead = 0;           // sm.cycles currently runs ahead of the main MCU
+    uint32_t ff_epoch = 0;          // bumped on every interrupt dispatch
+    uint32_t ff_epoch_at_head = 0;
+    uint64_t ff_c0 = 0;             // cycles at the jump origin ...
+    uint8_t ff_pos0 = 0;            // ... and the pass position there
+    uint64_t ff_timer_cycles0 = 0;  // timer state at the jump origin
+    uint8_t ff_timer_prescaler0 = 0;
+    uint8_t ff_timer_counter0 = 0;
