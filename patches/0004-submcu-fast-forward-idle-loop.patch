+    // --- idle-loop fast-forward state (sc55d patch 0016) -----------------
+    // The firmware spends nearly all of its time in a short loop that reads
+    // and writes nothing but zero-page RAM and leaves it unchanged. Once one
+    // full pass of such a loop is observed to reproduce the previous pass
+    // exactly (registers and RAM), the loop is stationary until the next
+    // event, and the sub-MCU's clock can be advanced across whole passes,
+    // landing at the recorded register state for that position. If the main
+    // MCU touches the sub-MCU while its clock is ahead, the clock is rewound
+    // to the exact position the true machine would be at. See SM_Update().
+    struct ff_entry_t { uint16_t pc; uint8_t a, x, y, s, sr; };
+    static constexpr unsigned ff_max_len = 64;
