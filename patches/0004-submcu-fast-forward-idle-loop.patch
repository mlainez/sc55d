+// ---- idle-loop fast-forward -------------------------------------------------
+//
+// Every iteration of SM_Update() is one instruction and 48 sub-MCU cycles.
+// The firmware's idle loop is a short sequence that touches only zero-page
+// RAM and leaves it as it found it; after any interrupt it settles back into
+// that loop within a pass or two and spins there until the next timer or
+// UART event. Executing those passes one instruction at a time is where the
+// sub-MCU's share of the emulator's time goes.
+//
+// Stationarity is detected, never assumed: a candidate head is the target of
+// any backward control transfer; from there one pass is recorded (registers
+// before each instruction) until the head recurs. The pass is stationary if
+// it was pure -- no access outside zero-page RAM, marked by SM_Read/SM_Write
+// -- no interrupt was dispatched during it, the sub-MCU never slept, and the
+// registers and the whole zero page are identical to the previous visit. A
+// pure pass is by construction invisible to the main MCU and to the outside
+// world, so between events the machine's state at position p of any later
+// pass is exactly the recorded state at p.
+//
+// While stationary, SM_Update() advances sm.cycles by whole instructions up
+// to the earliest of: the next timer fire, the delivery of a pending UART
+// byte, and a hard cap -- never past a point where an interrupt request is
+// already pending -- and installs the recorded registers for the landing
+// position. That may leave sm.cycles ahead of the main MCU. Any external
+// access to the sub-MCU (SM_SysRead, SM_SysWrite, MCU_PostUART) first calls
+// SM_FF_Sync(), which rewinds the clock to where the true machine would be at
+// that moment, restoring the registers for that position and recomputing the
+// timer from its state at the jump origin -- valid because no timer fire lay
+// inside the window. Once the main MCU catches up, execution proceeds one
+// instruction at a time again; the events that were bounded against are then
+// handled by the unchanged per-instruction code.
+//
+// Equivalence proof: patches/tests/mcu/sm_fastforward_equivalence.cpp.
+
+static inline void SM_FF_Signature(const submcu_t& sm, uint8_t* out)
+{
+    out[0] = (uint8_t)(sm.pc >> 8); out[1] = (uint8_t)sm.pc;
+    out[2] = sm.a; out[3] = sm.x; out[4] = sm.y; out[5] = sm.s; out[6] = sm.sr;
+    memcpy(out + 7, sm.ram, sizeof(sm.ram));
+}
+
+static inline void SM_FF_Install(submcu_t& sm, const submcu_t::ff_entry_t& e)
+{
+    sm.pc = e.pc; sm.a = e.a; sm.x = e.x; sm.y = e.y; sm.s = e.s; sm.sr = e.sr;
+}
+
+// First sm.cycles value that would make SM_UpdateTimer() fire, or ~0 if the
+// timer cannot fire. Derived from SM_UpdateTimer(): ticks are counted as
+// ceil((cycles - timer_cycles) / 16); the prescaler expires on tick P+1 and
+// every R+1 ticks after that; the counter fires on its (C+1)-th expiry.
+static inline uint64_t SM_FF_TimerFireCycle(const submcu_t& sm)
+{
+    if ((sm.device_mode[SM_DEV_TIMER_CTRL] & 0x20) != 0 || sm.sleep)
+        return ~(uint64_t)0;
+    const uint64_t P = sm.timer_prescaler, C = sm.timer_counter;
+    const uint64_t R = sm.device_mode[SM_DEV_PRESCALER];
+    const uint64_t T = (P + 1) + C * (R + 1);          // 1-based tick index of the fire
+    return sm.timer_cycles + 16 * (T - 1) + 1;          // cycles >= this processes tick T
+}
+
+void SM_FF_Sync(submcu_t& sm, uint64_t now)
+{
+    if (!sm.ff_ahead)
+        return;
+    sm.ff_ahead = 0;
+    // The true machine, caught up to `now`, stops at the first instruction
+    // boundary at or after it -- exactly as the loop in SM_Update() would.
+    const uint64_t m = now > sm.ff_c0 ? (now - sm.ff_c0 + 47) / 48 : 0;
+    const uint64_t truth = sm.ff_c0 + 48 * m;
+    if (truth >= sm.cycles)
+        return;                                          // the MCU has caught up: nothing to undo
+    sm.cycles = truth;
+    sm.ff_pos = (uint8_t)((sm.ff_pos0 + m) % sm.ff_len);
+    SM_FF_Install(sm, sm.ff_trace[sm.ff_pos]);
+    sm.timer_cycles = sm.ff_timer_cycles0;
+    sm.timer_prescaler = sm.ff_timer_prescaler0;
+    sm.timer_counter = sm.ff_timer_counter0;
+    SM_UpdateTimer(sm);
+}
